# Copy to keystore.properties (gitignored) and fill in real values to produce signed release builds.
#
# Create the keystore once:
#   keytool -genkey -v -keystore nodepiazza-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias nodepiazza
#
# storeFile is resolved relative to the repo root.

storeFile=nodepiazza-release.jks
storePassword=CHANGE_ME
keyAlias=nodepiazza
keyPassword=CHANGE_ME
